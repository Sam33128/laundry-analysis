{
  "expo": {
    "name": "laundry-mobile",
    "slug": "laundry-mobile",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/hero.png",
    "scheme": "laundrymobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090d16",
        "foregroundImage": "./assets/hero.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sam123yam.laundrymobile",
      "enableMinifyInReleaseBuilds": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/hero.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090d16",
          "image": "./assets/hero.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs to access your photos to analyze laundry.",
          "cameraPermission": "The app needs to access your camera to take photos of laundry."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow the app to use your location to fetch local weather data for accurate drying times."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "070534dc-9412-4e05-9bf0-54c9c81c87ce"
      }
    }
  }
} 